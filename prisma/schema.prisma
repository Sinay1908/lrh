// Prisma schema — Lyon Roller Hockey — MariaDB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nom          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Article {
  id          Int       @id @default(autoincrement())
  titre       String
  slug        String    @unique
  contenu     String    @db.LongText
  extrait     String?   @db.Text
  imageUrl    String?
  categorie   String?
  statut      String    @default("draft") // draft | published
  vues        Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("articles")
}

model Equipe {
  id          Int      @id @default(autoincrement())
  nom         String
  niveau      String
  categorie   String
  groupe      String   // senior | jeunes | loisir
  couleur     String   @default("#0D2150")
  horaire     String?
  coach       String?
  description String?  @db.Text
  nbJoueurs   Int      @default(0)
  actif       Boolean  @default(true)
  matchs      Match[]

  @@map("equipes")
}

model Match {
  id          Int       @id @default(autoincrement())
  equipeId    Int?
  equipe      Equipe?   @relation(fields: [equipeId], references: [id])
  domicile    Boolean   @default(true)
  adversaire  String
  competition String
  lieu        String?
  date        DateTime
  heure       String?
  statut      String    @default("upcoming") // upcoming | win | loss | draw
  scoreDom    Int?
  scoreExt    Int?
  createdAt   DateTime  @default(now())

  @@map("matchs")
}

model Inscription {
  id        Int      @id @default(autoincrement())
  prenom    String
  nom       String
  email     String
  telephone String?
  equipe    String?
  message   String?  @db.Text
  statut    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inscriptions")
}

model Sponsor {
  id      Int     @id @default(autoincrement())
  nom     String
  logoUrl String?
  siteUrl String?
  niveau  String  @default("partenaire") // premium | partenaire | supporter
  actif   Boolean @default(true)
  ordre   Int     @default(0)

  @@map("sponsors")
}

model Message {
  id        Int      @id @default(autoincrement())
  nom       String
  email     String
  sujet     String
  corps     String   @db.Text
  lu        Boolean  @default(false)
  archive   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("messages")
}

model Parametre {
  id      Int    @id @default(autoincrement())
  cle     String @unique
  valeur  String @db.Text
  section String @default("general")

  @@map("parametres")
}

model StaffMembre {
  id          Int      @id @default(autoincrement())
  nom         String
  role        String
  depuis      String?
  equipeNom   String?
  description String?  @db.Text
  actif       Boolean  @default(true)
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("staff")
}

model Tarif {
  id          Int      @id @default(autoincrement())
  saison      String   // "2025-2026"
  categorie   String   // "Adulte", "Jeune U17", etc.
  montant     Float
  description String?  @db.Text
  actif       Boolean  @default(true)
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tarifs")
}

model PalmaresItem {
  id          Int      @id @default(autoincrement())
  annee       String
  titre       String
  competition String
  description String?  @db.Text
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("palmares")
}

model ClassementLigne {
  id          Int      @id @default(autoincrement())
  competition String   // "Nationale 1"
  saison      String   // "2024-2025"
  position    Int
  equipe      String
  joues       Int      @default(0)
  gagnes      Int      @default(0)
  nuls        Int      @default(0)
  perdus      Int      @default(0)
  bpour       Int      @default(0)
  bcontre     Int      @default(0)
  points      Int      @default(0)
  isLyon      Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("classement")
}

model ProduitBoutique {
  id          Int      @id @default(autoincrement())
  nom         String
  categorie   String   // "Maillot", "Équipement", "Accessoire"
  prix        Float
  description String?  @db.Text
  badge       String?
  disponible  Boolean  @default(true)
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("boutique")
}
