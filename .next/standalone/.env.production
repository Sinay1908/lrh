# ── Base de données MariaDB Infomaniak ──────────────────────────────────────
# Remplacez avec vos vraies infos (Manager > Bases de données)
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Remplacez par votre vrai domaine
NEXTAUTH_URL="https://votre-domaine.com"

# Générez un secret sécurisé avec : openssl rand -base64 32
NEXTAUTH_SECRET="REMPLACEZ_PAR_UN_SECRET_LONG_ET_ALEATOIRE"
